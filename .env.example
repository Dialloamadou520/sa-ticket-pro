# ----------------------------------------------------------------------------
# Sa Ticket Pro — variables d'environnement
# Copiez ce fichier en `.env.local` et renseignez vos valeurs.
# L'application fonctionne en MODE DÉMO (données d'exemple) tant que Supabase
# n'est pas configuré.
# ----------------------------------------------------------------------------

# URL publique du site (utilisée pour les liens QR, OAuth, webhooks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service role (SERVEUR UNIQUEMENT — ne jamais exposer côté client)
SUPABASE_SERVICE_ROLE_KEY=

# --- Paiement : DexpayAfrica (Wave / Orange Money) --------------------------
DEXPAY_API_KEY=
DEXPAY_WEBHOOK_SECRET=
DEXPAY_BASE_URL=https://api.dexpayafrica.com

# --- Bonus IA (optionnel) ---------------------------------------------------
# Clé OpenAI pour la génération de descriptions d'événements
OPENAI_API_KEY=
