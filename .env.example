# ----------------------------------------------------------------------------
# Sa Ticket Pro — variables d'environnement
# Copiez ce fichier en `.env.local` et renseignez vos valeurs.
# L'application fonctionne en MODE DÉMO (données d'exemple) tant que Supabase
# n'est pas configuré.
# ----------------------------------------------------------------------------

# URL publique du site (utilisée pour les liens QR, OAuth, webhooks)
# IMPORTANT : DexPay refuse les URLs sans domaine public (ex. localhost) lors de
# la création d'une checkout session. En production, utilisez votre domaine
# (ex. https://sa-ticket-pro.vercel.app). Les paiements payants ne fonctionnent
# donc pas en local avec http://localhost:3000 (les événements gratuits, oui).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service role (SERVEUR UNIQUEMENT — ne jamais exposer côté client)
SUPABASE_SERVICE_ROLE_KEY=

# --- Paiement : DexPay / DEXCHANGE PAY (Wave / Orange Money / MTN / Moov) ----
# Docs : https://docs.dexpay.africa
# Clé publique (x-api-key, création des checkout sessions)
DEXPAY_PUBLIC_KEY=
# Clé secrète (SERVEUR UNIQUEMENT — opérations sensibles + vérif. webhook)
DEXPAY_SECRET_KEY=
# Secret de webhook (optionnel ; à défaut DEXPAY_SECRET_KEY est utilisé)
DEXPAY_WEBHOOK_SECRET=
# Prod : https://api.dexpay.africa/api/v1 — Sandbox : https://api-sandbox.dexpay.africa/api/v1
DEXPAY_BASE_URL=https://api.dexpay.africa/api/v1

# --- Bonus IA (optionnel) ---------------------------------------------------
# Clé OpenAI pour la génération de descriptions d'événements
OPENAI_API_KEY=
